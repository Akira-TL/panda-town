{
  "name": "panda-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/trading/*.test.ts src/trading/learning/*.test.ts src/scene/decision-framing.test.ts src/scene/camera-framing.test.ts",
    "test:browser": "playwright test --config tests/playwright.config.ts learning- trading-",
    "test:paths": "node --import tsx --test tests/gameplay-paths.test.ts",
    "test:trading": "node --import tsx --test src/trading/*.test.ts",
    "test:browser:trading": "playwright test --config tests/playwright.config.ts trading-",
    "test:browser:learning": "playwright test --config tests/playwright.config.ts learning-"
  },
  "dependencies": {
    "next": "15.4.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
